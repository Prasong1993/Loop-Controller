# Copy to .env and replace placeholders. Never commit .env.
NEXUS_API_KEY=replace-with-a-long-random-secret
NEXUS_DB=/app/data/nexus.db
NEXUS_RECORDS_DB=/app/data/nexus.db

# Required only for OpenAI API-backed planning/tool orchestration.
OPENAI_API_KEY=replace-with-your-openai-platform-api-key
NEXUS_OPENAI_MODEL=gpt-6-luna

# Paid API requests require this server switch and request-level approval.
NEXUS_OPENAI_BUDGET_APPROVED=false

# Optional trusted server-side MCP extension modules, comma-separated.
NEXUS_MCP_EXTENSION_MODULES=
